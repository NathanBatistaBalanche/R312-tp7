---
import Layout from "../../layouts/Layout.astro";

const selectClass =
  "rounded-lg border-0 bg-slate-50 px-3 py-2 text-sm font-semibold text-slate-700 outline-none transition focus:ring-2 focus:ring-cyan-400";
---

<Layout>
  <main class="min-h-screen bg-[#f4f7fb] px-4 py-10 text-slate-900 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">

      <header class="mb-10">
        <div class="mb-4 flex items-center gap-3">
          <span class="h-2.5 w-2.5 rounded-full bg-cyan-500"></span>
          <span class="text-xs font-bold uppercase tracking-[0.2em] text-slate-400">
            Data visualization
          </span>
        </div>

        <h1 class="text-5xl font-black tracking-tight text-slate-900 sm:text-6xl">
          Plusieurs filtres<span class="text-cyan-500">.</span>
        </h1>

        <p class="mt-4 max-w-xl text-base leading-7 text-slate-500">
          Quatrième essai : le graphique est piloté par trois select
          (espèce, île et sexe).
        </p>
        <a href="/" class="mt-4 inline-block font-semibold text-cyan-500 hover:underline">Retourner à l'accueil →</a>
      </header>

      <div class="mb-4 flex flex-wrap items-center gap-4 rounded-xl bg-white px-4 py-2 shadow-sm ring-1 ring-slate-200">
        <select name="species" id="species" class={selectClass}>
          <option value="">All species</option>
          <option value="Adelie">Adelie</option>
          <option value="Chinstrap">Chinstrap</option>
          <option value="Gentoo">Gentoo</option>
        </select>

        <select name="island" id="island" class={selectClass}>
          <option value="">All islands</option>
          <option value="Biscoe">Biscoe</option>
          <option value="Dream">Dream</option>
          <option value="Torgersen">Torgersen</option>
        </select>

        <select name="sex" id="sex" class={selectClass}>
          <option value="">All sexes</option>
          <option value="MALE">Male</option>
          <option value="FEMALE">Female</option>
        </select>
      </div>

      <nav class="mb-4 flex overflow-x-auto rounded-xl bg-white p-1 shadow-sm ring-1 ring-slate-200">
        <a href="/essais/simple" class="rounded-lg px-4 py-2.5 text-sm font-semibold text-slate-500 transition hover:bg-slate-100">Simple</a>
        <a href="/essais/penguin-simple" class="rounded-lg px-4 py-2.5 text-sm font-semibold text-slate-500 transition hover:bg-slate-100">Simple Penguin</a>
        <a href="/essais/penguin-filtre" class="rounded-lg px-4 py-2.5 text-sm font-semibold text-slate-500 transition hover:bg-slate-100">Penguin avec filtre</a>
        <a href="/essais/penguin-filtres" class="rounded-lg bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white">Penguin avec plusieurs filtres</a>
      </nav>

      <section class="overflow-hidden rounded-3xl bg-white shadow-sm ring-1 ring-slate-200">
        <div class="p-6 sm:p-8">
          <div class="mb-6">
            <span class="text-xs font-bold uppercase tracking-widest text-cyan-500">Essai 04</span>
            <h2 class="mt-2 text-2xl font-bold text-slate-900">Longueur et profondeur du bec</h2>
            <p class="mt-1 text-sm text-slate-500">Filtré selon l'espèce, l'île et le sexe.</p>
          </div>

          <div id="myplot" class="overflow-x-auto rounded-2xl bg-slate-50 p-3"></div>
        </div>

        <div class="border-t border-slate-100 px-6 py-4 sm:px-8">
          <p class="text-xs text-slate-400">Visualisation réalisée avec Astro & Observable Plot</p>
        </div>
      </section>

    </div>
  </main>
</Layout>

<script>
  import * as Plot from "@observablehq/plot";
  import penguins from "../../assets/penguins.json";

  const selectSpecies = document.querySelector("#species") as HTMLSelectElement;
  const selectIsland = document.querySelector("#island") as HTMLSelectElement;
  const selectSex = document.querySelector("#sex") as HTMLSelectElement;

  function renderPlot() {
    const species = selectSpecies.value;
    const island = selectIsland.value;
    const sex = selectSex.value;

    const div = document.querySelector("#myplot") as HTMLDivElement;
    div.innerHTML = "";

    const plot = Plot.plot({
      style: { background: "transparent" },
      marks: [
        Plot.dot(penguins, {
          x: "culmen_length_mm",
          y: "culmen_depth_mm",
          stroke: "species",
          filter: (d) =>
            (species === "" || d.species === species) &&
            (island === "" || d.island === island) &&
            (sex === "" || d.sex === sex),
        }),
      ],
    });
    div.append(plot);
  }

  for (const select of [selectSpecies, selectIsland, selectSex]) {
    select.addEventListener("change", renderPlot);
  }

  renderPlot();
</script>
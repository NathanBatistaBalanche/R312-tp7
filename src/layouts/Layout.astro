---
import "../styles/global.css";

const { pathname } = Astro.url;

const links = [
  { href: "/", label: "Penguins", active: pathname.startsWith("/penguins/") },
  { href: "/cars/", label: "Cars", active: pathname.startsWith("/cars/") },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro Basics</title>
  </head>
  <body>
    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
        <a href="/" class="text-lg font-black tracking-tight text-slate-900">
          Data<span class="text-cyan-500">.</span>
        </a>

        <nav class="flex gap-1">
          {
            links.map((link) => (
              <a
                href={link.href}
                class={`rounded-lg px-3 py-1.5 text-sm font-semibold transition ${
                  link.active
                    ? "bg-slate-900 text-white"
                    : "text-slate-500 hover:bg-slate-100"
                }`}
              >
                {link.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>